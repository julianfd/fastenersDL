op makeHelixWithLeadOut(P:Double, dia:Double, helix_height:Double) : Wire {
	val sqrt3 = sqrt(3)
	val H = sqrt3 / 2 * P
	val fillet_r = P * sqrt3 / 12
	var helix = geo.Wire.makeHelix(P, helix_height, dia / 2 + sqrt3 * 3 / 80 * P) // .translate(0, 0, -helix_height) as geo.Wire
	val leadOutR = dia / 2 + 0.55 * (5 / 8 * H + 0.5 * fillet_r)
	var helixLeadOut = geo.Wire.makeHelix(P, - P / 2, leadOutR + sqrt3 * 3 / 80 * P)
	helixLeadOut = helixLeadOut.translate(dia / 2 - leadOutR, 0, 0) as Wire
	helix = helix.add(helixLeadOut).rotate[axis = X angle = 180] as Wire
}
